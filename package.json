{
  "name": "tina-sprint-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tinacms dev -p 4007 --datalayer-port 9007 -c \"next dev -H 0.0.0.0 -p 3007\"",
